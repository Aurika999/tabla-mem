rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Citatul unui raspuns: doar id, nume si un text scurt.
    function validReply(data) {
      return !('replyTo' in data)
             || (data.replyTo is map
                 && data.replyTo.keys().hasOnly(['id', 'uid', 'name', 'text'])
                 && data.replyTo.text is string
                 && data.replyTo.text.size() <= 100
                 && data.replyTo.name is string
                 && data.replyTo.name.size() <= 30);
    }

    // Clasament pe nivel: oricine poate citi (public), dar fiecare user
    // poate scrie doar propriul scor (uid-ul din document trebuie sa fie al lui).
    match /scores/{scoreId} {
      allow read: if true;
      allow create, update: if request.auth != null
                             && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Clasament general: oricine poate citi, dar fiecare user isi poate
    // scrie doar propriul document (id-ul documentului == uid-ul lui).
    // Doar jucatorii autentificati (si cei anonimi din joc) vad profilurile,
    // fiindca pot contine poza de avatar.
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                             && request.auth.uid == playerId
                             && (!('avatar' in request.resource.data)
                                 || (request.resource.data.avatar is string
                                     && request.resource.data.avatar.size() <= 100000
                                     && request.resource.data.avatar.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
      allow delete: if false;
    }

    // Chat comun: oricine e autentificat poate citi si trimite mesaje,
    // doar in numele lui, cu text scurt si ora pusa de server.
    // Mesajele nu pot fi editate sau sterse din aplicatie.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt', 'replyTo'])
                    && validReply(request.resource.data)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Conversatii private intre doi jucatori. Id-ul e "uidA_uidB" (sortate),
    // deci doar cei doi membri pot citi sau scrie.
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow create, update: if request.auth != null
                            && request.auth.uid in chatId.split('_')
                            && request.resource.data.members.size() == 2
                            && request.resource.data.members.toSet() == chatId.split('_').toSet()
                            && request.resource.data.lastSender == request.auth.uid
                            && request.resource.data.lastMessage is string
                            && request.resource.data.lastMessage.size() <= 300
                            && request.resource.data.updatedAt == request.time;
      // Bifele albastre (readAt) si „scrie…” (typing): fiecare membru isi
      // modifica doar propria intrare, fara sa atinga restul conversatiei.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'typing'])
                    && request.resource.data.get('readAt', {}).diff(resource.data.get('readAt', {}))
                         .affectedKeys().hasOnly([request.auth.uid])
                    && request.resource.data.get('typing', {}).diff(resource.data.get('typing', {}))
                         .affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in chatId.split('_');
        allow create: if request.auth != null
                      && request.auth.uid in chatId.split('_')
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt', 'replyTo'])
                    && validReply(request.resource.data)
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 30
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 300
                      && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Apeluri audio (WebRTC). Documentul tine doar semnalizarea (oferta,
    // raspunsul, starea apelului); sunetul nu trece prin Firebase.
    // Doar apelantul si cel sunat pot citi sau modifica un apel.
    match /calls/{callId} {
      function isParty(data) {
        return request.auth != null
               && (request.auth.uid == data.caller || request.auth.uid == data.callee);
      }

      allow read: if isParty(resource.data);
      allow create: if request.auth != null
                    && request.resource.data.caller == request.auth.uid
                    && request.resource.data.callee is string
                    && request.resource.data.callee != request.auth.uid
                    && request.resource.data.status == 'ringing';
      allow update: if isParty(resource.data)
                    && request.resource.data.caller == resource.data.caller
                    && request.resource.data.callee == resource.data.callee;
      allow delete: if false;

      // Candidatii ICE ai fiecarei parti.
      match /{side}/{candidateId} {
        function call() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        allow read, create: if (side == 'callerCandidates' || side == 'calleeCandidates')
                            && request.auth != null
                            && request.auth.uid in [call().caller, call().callee];
        allow update, delete: if false;
      }
    }

    // Concurs test: 2-10 jucatori, aceleasi 10 intrebari.
    // Organizatorul porneste/anuleaza concursul; ceilalti pot doar sa intre
    // sau sa iasa (doar ei insisi), cat timp concursul asteapta.
    match /contests/{contestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.host == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 40
                    && request.resource.data.players.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null && (
                      (resource.data.host == request.auth.uid
                        && request.resource.data.host == resource.data.host)
                      || (resource.data.status == 'waiting'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
                        && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
                        && request.resource.data.players.size() <= 10)
                      // La final, oricare participant salveaza clasamentul (pentru Statistici).
                      || (resource.data.status == 'running'
                        && request.auth.uid in resource.data.players
                        && request.resource.data.status == 'finished'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'finishedAt', 'participants', 'ranking']))
                    );
      allow delete: if false;

      // Progresul fiecarui jucator; fiecare isi scrie doar propriul rezultat.
      match /results/{playerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && request.auth.uid == playerId
                              && playerId in get(/databases/$(database)/documents/contests/$(contestId)).data.players
                              && request.resource.data.correct is int
                              && request.resource.data.correct >= 0
                              && request.resource.data.correct <= 10;
        allow delete: if false;
      }
    }

    // Orice altceva e blocat implicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
